{
  "name": "mini-daw",
  "version": "0.1.0",
  "description": "Tiny MVP DAW: drag audio in, trim, fade, play, export WAV.",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "package:win": "pnpm build && electron-builder --win --x64",
    "package:win:portable": "pnpm build && electron-builder --win portable --x64",
    "package:win:installer": "pnpm build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.minidaw.app",
    "productName": "DAW",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "author": "mv"
}
